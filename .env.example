# LLM Provider Settings
LLM_PROVIDER="groq"    # "groq" | "openai"
LLM_MODEL="llama-3.3-70b-versatile"
LLM_TEMPERATURE=0.0

# Provider API Keys (only the active provider's key needs to be set)
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Search
TAVILY_API_KEY=""

# LangSmith (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=""
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""

# LangFuse (optional)
LANGFUSE_ENABLED=false
LANGFUSE_API_KEY=""

# WhatsApp / Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_VERIFY_CHANNEL="whatsapp"
WHATSAPP_VERIFY_TOKEN=""

# Database & Supabase
DATABASE_URL=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# App
DEBUG=true
ONBOARDING_URL=""
